{
  "reload_style_on_change": true,
  "position": "bottom",
  "height": 26,
  "spacing": 4,

  "modules-left": [
    "sway/workspaces"
  ],
  "modules-center": [],
  "modules-right": [
    "idle_inhibitor",
    "pulseaudio",
    "network",
    "power-profiles-daemon",
    "cpu",
    "memory",
    "backlight",
    "battery",
    "clock",
    "tray"
  ],

  "sway/workspaces": {
    "disable-scroll": true,
    "format": "{name}"
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "󰅶",
      "deactivated": "󰾪"
    }
  },
  "pulseaudio": {
    "format": "{volume}% {icon}",
    "format-bluetooth": "{volume}% ",
    "format-muted": "󰝟",
    "format-source": "",
    "format-source-muted": " ",
    "format-icons": {
      "headphone": "",
      "headset": "󰋎",
      "default": ["", "", ""]
    },
    "scroll-step": 5
  },
  "network": {
    "format-wifi": "{essid} {signalStrength}% ",
    "format-ethernet": "{ifname} 󰈀",
    "format-disconnected": "Disconnected 󰖪",
    "tooltip-format": "{ifname}: {ipaddr}/{cidr}"
  },
  "power-profiles-daemon": {
    "format": "{icon}",
    "format-icons": {
      "performance": "",
      "balanced": "",
      "power-saver": ""
    },
    "tooltip-format": "Power profile: {profile}"
  },
  "cpu": {
    "interval": 5,
    "format": "CPU {usage}%",
    "tooltip": false
  },
  "memory": {
    "interval": 5,
    "format": "RAM {percentage}%"
  },
  "backlight": {
    "format": "{percent}% {icon}",
    "format-icons": ["󰃞", "󰃟", "󰃠"]
  },
  "battery": {
    "bat": "BAT0",
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{capacity}% {icon}",
    "format-charging": "{capacity}% 󰂄",
    "format-plugged": "{capacity}% ",
    "format-icons": ["󰁺", "󰁻", "󰁽", "󰁿", "󰁹"]
  },
  "clock": {
    "format": "{:%a %d %b  %H:%M}",
    "format-alt": "{:%Y-%m-%d  W%V}",
    "tooltip-format": "<big>{:%B %Y}</big>\n<tt><small>{calendar}</small></tt>"
  },
  "tray": {
    "icon-size": 16,
    "spacing": 8
  }
}
